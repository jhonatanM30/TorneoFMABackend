# Copia este archivo a ".env" (sin el ".example") y ajusta los valores.
# ".env" NO debe subirse al repositorio (agregar a .gitignore).

# Puerto del host donde queda expuesto el backend (http://localhost:<SERVER_PORT>)
SERVER_PORT=57075

# Datos de conexión al MySQL que YA tienes corriendo en Docker
# (el contenedor creado en la Fase 3). Si vas a levantar MySQL también
# desde Compose (ver DEPLOYMENT.md, Opción B), cambia DB_HOST a "mysql".
DB_HOST=host.docker.internal
DB_PORT=3308
DB_NAME=masqueamigos
DB_USER=masqueamigos
DB_PASSWORD=desarrollo

# Seguridad (login con JWT). Las tres son obligatorias: docker compose no
# arranca si alguna esta vacia. Define tus propios valores en ".env".
# - JWT_SECRET: secreto de firma de los tokens, 32 caracteres o mas, aleatorio.
# - ADMIN_*: cuenta de administrador que se crea al arrancar si no existe.
APP_SECURITY_JWT_SECRET=
APP_SECURITY_ADMIN_USERNAME=
APP_SECURITY_ADMIN_PASSWORD=
# Opcional: vigencia del token (ISO-8601). Por defecto PT3M (3 minutos).
# APP_SECURITY_JWT_TTL=PT3M

# Solo se usa si defines el servicio "mysql" en docker-compose.yml
# (Opción B en DEPLOYMENT.md, para levantar MySQL también desde Compose).
MYSQL_ROOT_PASSWORD=root
